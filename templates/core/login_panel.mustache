{{!
    @template core/login_panel

    Content for the dark left panel of the split-screen login layout, based on mockup/Retani Login.dc.html.

    When leftinstructions is provided (i.e. the site has custom auth instructions configured),
    it replaces the carousel. The slides are set in the "Login page" tab of the theme settings
    (see theme_retani_studio\output\login_carousel).

    Context variables:
    * logourl - URL of the logo uploaded in the theme settings, if any.
    * sitename - Name of the site, shown as a wordmark when there is no logo.
    * leftinstructions - Custom auth instructions, if configured.
    * carousel - False when there are no slides, otherwise:
      * propsjson - The LoginCarousel component props, as JSON.
      * first - The first slide (title, body, image, alt), drawn until the component loads.

    Example context (json):
    {
        "logourl": "",
        "sitename": "retani",
        "leftinstructions": "",
        "carousel": {
            "propsjson": "{\"interval\": 6000, \"slides\": []}",
            "first": {"title": "Teach better with clearer data", "body": "See how every course is performing.",
                "image": "https://example.com/slide1.jpg", "alt": "Students working together around a laptop"}
        }
    }
}}
<div class="login-layout-brand">
    {{#logourl}}
        <img class="login-layout-logo" src="{{logourl}}" alt="{{sitename}}">
    {{/logourl}}
    {{^logourl}}
        <span class="login-layout-sitename">{{sitename}}<span class="login-layout-sitename-dot" aria-hidden="true">.</span></span>
    {{/logourl}}
</div>
<div class="login-layout-left-content">
    {{^leftinstructions}}
        {{#carousel}}
        {{#react}}
        {
            "component": "@moodle/lms/theme_retani_studio/LoginCarousel",
            "class": "login-carousel-mount",
            "props": {{{propsjson}}}
        }
        {{#first}}
        <div class="login-carousel">
            <div class="login-carousel-copy">
                <h2 class="login-carousel-title">“{{title}}”</h2>
                <p class="login-carousel-body">{{body}}</p>
            </div>
            <div class="login-carousel-frame">
                <div class="login-carousel-backdrop" aria-hidden="true"></div>
                <div class="login-carousel-viewport">
                    <img class="login-carousel-image is-active" src="{{image}}" alt="{{alt}}">
                </div>
            </div>
        </div>
        {{/first}}
        {{/react}}
        {{/carousel}}
    {{/leftinstructions}}
    {{#leftinstructions}}
        <div class="login-layout-instructions mx-auto text-start">
            {{{leftinstructions}}}
        </div>
    {{/leftinstructions}}
</div>
