{{!
    @template core_calendar/view_selector

    Retani: the calendar views as a segmented control (Month / Day / Upcoming) instead of a dropdown.

    core_calendar/view_manager listens for clicks on the links inside [data-region="view-selector"] (reading
    data-view, data-year, ... from the clicked element, so the label is the link's own text) and updates the
    data-courseid of the "ul li a" links when the course changes, so that structure stays.

    Example context (json):
    {
        "viewingmonth": true,
        "date": {"year": 2026, "mon": 10, "mday": 19},
        "courseid": 1,
        "categoryid": 0
    }
}}
<div data-region="view-selector" class="retani-calendar-views">
    <ul class="retani-calendar-segments" role="list">
        <li>
            <a class="retani-calendar-segment {{#viewingmonth}}active{{/viewingmonth}}" href="#" data-view="month"{{#viewingmonth}} aria-current="true"{{/viewingmonth}}
                data-year="{{date.year}}" data-month="{{date.mon}}" data-day="{{date.mday}}" data-courseid="{{courseid}}" data-categoryid="{{categoryid}}">{{#str}} month {{/str}}</a>
        </li>
        <li>
            <a class="retani-calendar-segment {{#viewingday}}active{{/viewingday}}" href="#" data-view="day"{{#viewingday}} aria-current="true"{{/viewingday}}
                data-year="{{date.year}}" data-month="{{date.mon}}" data-day="{{date.mday}}" data-courseid="{{courseid}}" data-categoryid="{{categoryid}}">{{#str}} day, core_calendar {{/str}}</a>
        </li>
        <li>
            <a class="retani-calendar-segment {{#viewingupcoming}}active{{/viewingupcoming}}" href="#" data-view="upcoming"{{#viewingupcoming}} aria-current="true"{{/viewingupcoming}}
                data-year="{{date.year}}" data-month="{{date.mon}}" data-day="{{date.mday}}" data-courseid="{{courseid}}" data-categoryid="{{categoryid}}">{{#str}} upcomingevents, core_calendar {{/str}}</a>
        </li>
    </ul>
</div>
