{{!
    @template core_form/collapsesections

    The "Expand all / Collapse all" control above the form sections, drawn as the same small outlined
    button as the course page's toggle. core_form/collapsesections swaps the two labels through the
    "collapsed" class.

    Example context (json):
    {
    }
}}
<div class="collapsible-actions retani-formsections-actions">
    <a id="collapsesections{{uniqid}}" href="#" aria-expanded="false" class="collapseexpand collapsemenu collapsed retani-formsections-toggle"{{!
            }} role="button">
        <span class="collapseall">
            {{#pix}} t/collapsedchevron_up, core {{/pix}}
            <span>{{#str}}collapseall{{/str}}</span>
        </span>
        <span class="expandall">
            {{#pix}} t/expandedchevron, core {{/pix}}
            <span>{{#str}}expandall{{/str}}</span>
        </span>
    </a>
</div>
{{#js}}
require(['core_form/collapsesections'], function(Collapsesections) {
    Collapsesections.init('#collapsesections{{uniqid}}');
});
{{/js}}
