{{!
    @template core_form/element-header

    Renders a form section header, as the header of a card like the admin settings cards
    (core_admin/settings): a chevron and the section name, the help button, and on the right the number
    of fields in the section (filled in by theme_retani_studio/formsections).

    The section JS (core_form/collapsesections and moodle-form-shortforms) needs the .fheader toggle,
    its "collapsed" class, and the .fcontainer that follows.

    Example context (json):
    {
        "id": "id_general",
        "header": "General",
        "collapsed": 0,
        "collapseable": 1,
        "helpbutton": "Help"
    }
}}
<legend class="visually-hidden">{{{header}}}</legend>
<div class="retani-formsection-header ftoggler">
    <h3 class="retani-formsection-heading">
        {{#collapseable}}
            <a data-bs-toggle="collapse"
               href="#{{id}}container"
               role="button"
               aria-expanded="{{#collapsed}}false{{/collapsed}}{{^collapsed}}true{{/collapsed}}"
               aria-controls="{{id}}container"
               class="fheader retani-formsection-toggle {{#collapsed}}collapsed{{/collapsed}}"
            >
                <span class="retani-formsection-chevron" aria-hidden="true">
                    <span class="dir-rtl-hide">{{#pix}} t/collapsedchevron, core {{/pix}}</span>
                    <span class="dir-ltr-hide">{{#pix}} t/collapsedchevron_rtl, core {{/pix}}</span>
                </span>
                <span class="retani-formsection-title">{{{header}}}</span>
            </a>
        {{/collapseable}}
        {{^collapseable}}
            <span class="retani-formsection-title">{{{header}}}</span>
        {{/collapseable}}
    </h3>
    {{{helpbutton}}}
    <span class="retani-formsection-count" data-region="retani-formsection-count" aria-hidden="true"></span>
</div>
<div id="{{id}}container" class="fcontainer {{#collapseable}}collapseable collapse {{/collapseable}} {{^collapsed}}show{{/collapsed}}">
{{#js}}
require(['theme_retani_studio/formsections'], function(FormSections) {
    FormSections.init();
});
{{/js}}
