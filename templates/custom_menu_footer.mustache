{{!
    @template theme_retani_studio/custom_menu_footer

    Renders the custom menu items as a nested list in the footer.

    Context variables required for this template:
    * children - Array of custom menu items.
      * text - The item label.
      * url - The item link (optional).
      * title - The link title.
      * divider - Whether the item is a divider.
      * haschildren - Whether the item has nested children.
      * children - Nested custom menu items.

    Example context (json):
    {
        "children": [
            {"text": "Moodle community", "url": "https://moodle.org", "title": "Moodle community", "haschildren": false},
            {"text": "Support", "haschildren": true, "children": [
                {"text": "Docs", "url": "https://docs.moodle.org", "title": "Docs", "haschildren": false}
            ]}
        ]
    }
}}
    {{#children}}
        {{^divider}}
            {{#url}}
                <li><a href="{{{url}}}" title="{{{title}}}">{{{text}}}</a></li>
            {{/url}}
            {{^url}}
                <li>{{{text}}}</li>
            {{/url}}
        {{/divider}}
        {{#haschildren}}
            <li>
                <ul class="list-unstyled ms-3">
                    {{> theme_retani_studio/custom_menu_footer }}
                </ul>
            </li>
        {{/haschildren}}
    {{/children}}
