{{!
    @template theme_retani_studio/course_listing

    The list of courses at /course/index.php (layout/coursecategory.php), with the front page header and footer.

    The search, filters and sort are a GET form, so they work without JavaScript; with JavaScript, changing a filter
    or the sort submits the form straight away.

    Context variables required for this template:
    * output, bodyattributes - As for every layout
    * sitename, logourl, announcement, header, footer - The shared parts, see theme_retani_studio/frontpage
    * listing - Built by \theme_retani_studio\output\course_listing

    Example context (json):
    {
        "output": {"doctype": "<!DOCTYPE html>", "page_title": "Courses", "main_content": ""},
        "bodyattributes": "",
        "sitename": "Retani",
        "header": {"loginurl": "#", "loginlabel": "Log in"},
        "footer": {"copyright": "© 2026 Retani"},
        "listing": {
            "title": "All courses",
            "intro": "Browse every course.",
            "breadcrumbs": [{"text": "home", "url": "#"}, {"text": "courses", "url": null, "last": true}],
            "actionurl": "#",
            "search": "",
            "teachers": [{"id": 3, "name": "Charles Bailey", "checked": false}],
            "hasteachers": true,
            "certificate": [{"value": "any", "label": "Any", "checked": true}],
            "sorts": [{"value": "name", "label": "Course name", "selected": true}],
            "count": "1 course",
            "hascourses": true,
            "courses": [{"id": 2, "code": "CT101", "name": "Critical Thinking", "url": "#", "image": "#",
                "summary": "", "teachers": "Charles Bailey", "certificate": "awards a certificate: no"}],
            "pagination": false
        }
    }
}}
{{> theme_retani_studio/head }}
<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}
<div id="page-wrapper" class="retani-fp" data-region="retani-frontpage">
    {{{ output.standard_top_of_body_html }}}

    {{#announcement}}
        <div class="rfp-announcement">{{.}}</div>
    {{/announcement}}

    {{> theme_retani_studio/retani/frontpage_header }}

    <div id="page" class="rfp-page">
    {{#listing}}
        <section class="rcl-intro">
            <div class="rfp-container">
                <nav aria-label="{{#str}}breadcrumb, access{{/str}}" class="rcl-breadcrumb">
                    {{#breadcrumbs}}
                        {{#url}}<a href="{{url}}">{{text}}</a>{{/url}}{{^url}}<span {{#last}}aria-current="page"{{/last}}>{{text}}</span>{{/url}}{{^last}} / {{/last}}
                    {{/breadcrumbs}}
                </nav>
                <h1 class="rfp-display">{{title}}</h1>
                {{#intro}}<p class="rcl-lead">{{intro}}</p>{{/intro}}
                <div class="rcl-searchrow">
                    <form role="search" class="rcl-search" action="{{actionurl}}" method="get">
                        {{#categoryid}}<input type="hidden" name="categoryid" value="{{categoryid}}">{{/categoryid}}
                        {{#selectedteachers}}<input type="hidden" name="teacher[]" value="{{id}}">{{/selectedteachers}}
                        <input type="hidden" name="cert" value="{{certificatevalue}}">
                        <input type="hidden" name="sort" value="{{sortvalue}}">
                        <label for="rcl-q" class="visually-hidden">{{#str}}searchcourses, core{{/str}}</label>
                        <input id="rcl-q" type="search" name="q" value="{{search}}" placeholder="{{#str}}searchcourses, core{{/str}}">
                        <button type="submit" class="rfp-btn rfp-btn-dark">{{#str}}search, core{{/str}}</button>
                    </form>
                    {{#manageurl}}
                        <a class="rfp-btn rfp-btn-outline" href="{{manageurl}}">{{#str}}managecourses, core{{/str}}</a>
                    {{/manageurl}}
                </div>
            </div>
        </section>

        <section class="rcl-results">
            <div class="rfp-container rcl-row">
                <form id="rcl-filters" class="rcl-filters" action="{{actionurl}}" method="get" data-region="rcl-filters" aria-label="{{#str}}cl:filters, theme_retani_studio{{/str}}">
                    {{#categoryid}}<input type="hidden" name="categoryid" value="{{categoryid}}">{{/categoryid}}
                    {{#search}}<input type="hidden" name="q" value="{{search}}">{{/search}}
                    {{#hasteachers}}
                    <fieldset class="rcl-group">
                        <legend class="rfp-code rfp-code-sm">{{#str}}cl:teacher, theme_retani_studio{{/str}}</legend>
                        {{#teachers}}
                            <label class="rcl-option"><input type="checkbox" name="teacher[]" value="{{id}}" {{#checked}}checked{{/checked}} data-autosubmit>{{name}}</label>
                        {{/teachers}}
                    </fieldset>
                    {{/hasteachers}}
                    <fieldset class="rcl-group">
                        <legend class="rfp-code rfp-code-sm">{{#str}}cl:certificate, theme_retani_studio{{/str}}</legend>
                        {{#certificate}}
                            <label class="rcl-option"><input type="radio" name="cert" value="{{value}}" {{#checked}}checked{{/checked}} data-autosubmit>{{label}}</label>
                        {{/certificate}}
                    </fieldset>
                    <div class="rcl-group rcl-filter-actions">
                        <button type="submit" class="rfp-btn rfp-btn-outline" data-region="rcl-apply">{{#str}}cl:apply, theme_retani_studio{{/str}}</button>
                        {{#isfiltered}}<a class="rcl-clear" href="{{clearurl}}">{{#str}}cl:clear, theme_retani_studio{{/str}}</a>{{/isfiltered}}
                    </div>
                </form>

                <div class="rcl-main">
                    <div class="rcl-toolbar">
                        <span class="rfp-code rcl-count" role="status">{{count}}</span>
                        <label class="rcl-sort">{{#str}}cl:sortby, theme_retani_studio{{/str}}
                            <select name="sort" form="rcl-filters" data-autosubmit>
                                {{#sorts}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/sorts}}
                            </select>
                        </label>
                    </div>

                    {{#hascourses}}
                    <ul class="rcl-list" role="list">
                        {{#courses}}
                        <li>
                            <a class="rcl-card" href="{{url}}">
                                <img src="{{image}}" alt="" loading="lazy" class="rcl-card-image">
                                <div class="rcl-card-body">
                                    <span class="rfp-code rfp-code-sm">{{code}}{{#hidden}} · {{#str}}hiddenfromstudents, core{{/str}}{{/hidden}}</span>
                                    <h2 class="rcl-card-title">{{name}}</h2>
                                    {{#summary}}<p class="rcl-card-summary">{{summary}}</p>{{/summary}}
                                    {{#teachers}}<p class="rcl-card-teachers"><span class="rfp-code-font">{{#str}}cl:teacherlabel, theme_retani_studio{{/str}} </span>{{teachers}}</p>{{/teachers}}
                                    <div class="rcl-card-foot">
                                        <span class="rfp-code-font">{{certificate}}</span>
                                        <span class="rfp-code-font rcl-card-go">{{#str}}cl:viewcourse, theme_retani_studio{{/str}} →</span>
                                    </div>
                                </div>
                            </a>
                        </li>
                        {{/courses}}
                    </ul>
                    {{/hascourses}}
                    {{^hascourses}}
                        <div class="rcl-empty">
                            <p>{{#str}}cl:nocourses, theme_retani_studio{{/str}}</p>
                            {{#isfiltered}}<a class="rfp-btn rfp-btn-outline" href="{{clearurl}}">{{#str}}cl:clear, theme_retani_studio{{/str}}</a>{{/isfiltered}}
                        </div>
                    {{/hascourses}}

                    {{#pagination}}
                    <nav class="rcl-pagination" aria-label="{{#str}}page, core{{/str}}">
                        {{#previousurl}}<a href="{{previousurl}}" class="rcl-page" aria-label="{{#str}}previous, core{{/str}}">←</a>{{/previousurl}}
                        {{#links}}
                            {{#gap}}<span class="rcl-gap" aria-hidden="true">…</span>{{/gap}}
                            {{^gap}}
                                {{#current}}<span class="rcl-page rcl-page-current" aria-current="page">{{number}}</span>{{/current}}
                                {{^current}}<a href="{{url}}" class="rcl-page">{{number}}</a>{{/current}}
                            {{/gap}}
                        {{/links}}
                        {{#nexturl}}<a href="{{nexturl}}" class="rcl-page" aria-label="{{#str}}next, core{{/str}}">→</a>{{/nexturl}}
                    </nav>
                    {{/pagination}}
                </div>
            </div>
        </section>
    {{/listing}}
        {{! The page must output the main content; the standard category listing is kept out of sight. }}
        <div class="d-none">{{{ output.main_content }}}</div>
    </div>

    {{> theme_retani_studio/retani/frontpage_footer }}
    {{{ output.standard_after_main_region_html }}}
</div>
{{#js}}
require(['theme_retani_studio/frontpage'], function(Frontpage) {
    Frontpage.init();
});
{{/js}}
</body>
</html>
