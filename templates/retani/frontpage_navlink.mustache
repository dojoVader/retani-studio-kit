{{!
    @template theme_retani_studio/retani/frontpage_navlink

    A link of the front page navigation, with a menu when it has children.

    Example context (json):
    {
        "text": "Help",
        "url": "#",
        "isactive": false,
        "haschildren": true,
        "id": "retani-fp-menu-1",
        "children": [{"text": "Documentation", "url": "#"}]
    }
}}
{{^haschildren}}
<li><a class="rfp-nav-link {{#isactive}}active{{/isactive}}" href="{{url}}" {{#isactive}}aria-current="page"{{/isactive}}>{{text}}</a></li>
{{/haschildren}}
{{#haschildren}}
<li class="rfp-dropdown" data-region="rfp-menu">
    <button type="button" class="rfp-nav-link {{#isactive}}active{{/isactive}}" data-action="rfp-menu" aria-expanded="false" aria-controls="{{id}}">
        {{text}}{{> theme_retani_studio/retani/frontpage_chevron }}
    </button>
    <ul class="rfp-dropdown-panel" id="{{id}}" role="list">
        {{#children}}<li><a class="rfp-mm-link" href="{{url}}">{{text}}</a></li>{{/children}}
    </ul>
</li>
{{/haschildren}}
