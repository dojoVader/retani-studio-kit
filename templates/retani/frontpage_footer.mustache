{{!
    @template theme_retani_studio/retani/frontpage_footer

    The footer of the front page. It also carries the standard footer output of the page (JavaScript, performance
    information and debugging), which every layout must print.

    Context variables required for this template:
    * sitename, logourl - As for theme_retani_studio/retani/frontpage_header
    * footer.text - The text under the logo
    * footer.socials - Social network links, each with url, label and one of iconfacebook, iconx, iconyoutube,
      iconinstagram or iconlinkedin
    * footer.columns - Link columns, each with title and links (text, url)
    * footer.contacttitle, footer.contacts - Contact details, each with text, an optional url and one of iconaddress,
      iconemail or iconphone
    * footer.copyright, footer.legallinks - The bottom line

    Example context (json):
    {
        "sitename": "Retani",
        "footer": {
            "text": "Start, switch or advance your career.",
            "socials": [{"url": "#", "label": "LinkedIn", "iconlinkedin": true}],
            "columns": [{"title": "Explore", "links": [{"text": "All courses", "url": "#"}]}],
            "contacttitle": "Contact",
            "contacts": [{"text": "hello@example.com", "url": "mailto:hello@example.com", "iconemail": true}],
            "copyright": "© 2026 Retani",
            "legallinks": [{"text": "Privacy", "url": "#"}]
        }
    }
}}
<footer class="rfp-footer">
    {{#footer}}
    <div class="rfp-container">
        <div class="rfp-footer-row">
            <div class="rfp-footer-brand">
                <a href="{{config.wwwroot}}/?redirect=0" class="rfp-logo rfp-logo-footer">
                    {{#logourl}}<img src="{{logourl}}" alt="{{sitename}}">{{/logourl}}
                    {{^logourl}}<span class="rfp-wordmark">{{sitename}}<span aria-hidden="true">.</span></span>{{/logourl}}
                </a>
                {{#text}}<p>{{text}}</p>{{/text}}
                {{#socials.0}}
                <ul class="rfp-socials" role="list">
                    {{#socials}}
                    <li>
                        <a href="{{url}}" aria-label="{{label}}" title="{{label}}" target="_blank" rel="noopener">
                            <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                {{#iconfacebook}}<path d="M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v6h4v-6h3l1-4h-4V8z"/>{{/iconfacebook}}
                                {{#iconx}}<path d="M4 4l16 16M20 4L4 20"/>{{/iconx}}
                                {{#iconyoutube}}<rect x="3" y="6" width="18" height="12" rx="3"/><path d="M10 9.5v5l4-2.5z"/>{{/iconyoutube}}
                                {{#iconinstagram}}<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/>{{/iconinstagram}}
                                {{#iconlinkedin}}<path d="M6 9v10M6 5v.01M11 19v-6a3 3 0 0 1 6 0v6M11 9v10"/>{{/iconlinkedin}}
                            </svg>
                        </a>
                    </li>
                    {{/socials}}
                </ul>
                {{/socials.0}}
            </div>
            {{#columns}}
            <div class="rfp-footer-col">
                {{#title}}<h2 class="rfp-footer-title">{{title}}</h2>{{/title}}
                <ul role="list">
                    {{#links}}<li><a href="{{url}}">{{text}}</a></li>{{/links}}
                </ul>
            </div>
            {{/columns}}
            {{#contacts.0}}
            <div class="rfp-footer-col rfp-footer-contact">
                {{#contacttitle}}<h2 class="rfp-footer-title">{{contacttitle}}</h2>{{/contacttitle}}
                <ul role="list">
                    {{#contacts}}
                    <li>
                        <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            {{#iconaddress}}<path d="M12 21s7-6 7-11a7 7 0 0 0-14 0c0 5 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/>{{/iconaddress}}
                            {{#iconemail}}<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>{{/iconemail}}
                            {{#iconphone}}<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/>{{/iconphone}}
                        </svg>
                        {{#url}}<a href="{{url}}">{{text}}</a>{{/url}}{{^url}}<span>{{text}}</span>{{/url}}
                    </li>
                    {{/contacts}}
                </ul>
            </div>
            {{/contacts.0}}
        </div>
        <div class="rfp-footer-bottom">
            <span class="rfp-code-font">{{copyright}}</span>
            {{#legallinks.0}}
            <ul class="rfp-legal" role="list">
                {{#legallinks}}<li><a href="{{url}}">{{text}}</a></li>{{/legallinks}}
            </ul>
            {{/legallinks.0}}
        </div>
    </div>
    {{/footer}}
    <div class="rfp-footer-system">
        <div class="logininfo visually-hidden">{{{ output.login_info }}}</div>
        <div class="tool_usertours-resettourcontainer"></div>
        {{{ output.standard_footer_html }}}
        {{{ output.standard_end_of_body_html }}}
    </div>
    <div class="footer-content-debugging footer-dark bg-dark text-light">
        <div class="container-fluid footer-dark-inner">
            {{{ output.debug_footer_html }}}
        </div>
    </div>
</footer>
