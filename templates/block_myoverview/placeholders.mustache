{{!
    @template block_myoverview/placeholders

    Loading placeholders for the Retani course overview, shown until the CourseOverview component has its first
    page: skeleton cards in card view, skeleton table rows otherwise, matching what the component draws itself.

    Context variables required for this template:
    * iscardview - Whether the user's view is the card grid.

    Example context (json):
    {
        "iscardview": true
    }
}}
<div data-region="loading-placeholder-content" aria-hidden="true">
    {{#iscardview}}
    <div class="retani-courseoverview-cards">
        <div class="retani-courseoverview-card is-skeleton"><span class="retani-courseoverview-cardimage"></span><span class="retani-courseoverview-cardbody"><span></span><span></span><span></span></span></div>
        <div class="retani-courseoverview-card is-skeleton"><span class="retani-courseoverview-cardimage"></span><span class="retani-courseoverview-cardbody"><span></span><span></span><span></span></span></div>
        <div class="retani-courseoverview-card is-skeleton"><span class="retani-courseoverview-cardimage"></span><span class="retani-courseoverview-cardbody"><span></span><span></span><span></span></span></div>
        <div class="retani-courseoverview-card is-skeleton"><span class="retani-courseoverview-cardimage"></span><span class="retani-courseoverview-cardbody"><span></span><span></span><span></span></span></div>
    </div>
    {{/iscardview}}
    {{^iscardview}}
    <div class="retani-courseoverview-table">
        <div class="retani-courseoverview-row is-head"><span></span><span></span><span></span><span></span><span></span><span></span></div>
        <div class="retani-courseoverview-row is-skeleton"><span></span><span></span><span></span><span></span><span></span><span></span></div>
        <div class="retani-courseoverview-row is-skeleton"><span></span><span></span><span></span><span></span><span></span><span></span></div>
        <div class="retani-courseoverview-row is-skeleton"><span></span><span></span><span></span><span></span><span></span><span></span></div>
        <div class="retani-courseoverview-row is-skeleton"><span></span><span></span><span></span><span></span><span></span><span></span></div>
    </div>
    {{/iscardview}}
</div>
