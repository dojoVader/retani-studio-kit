{{!
    @template theme_retani_studio/blocks-drawer

    Drawer region that holds the side-pre blocks.

    Context variables required for this template:
    * blocksdraweropen - Whether the blocks drawer is open.
    * sidepreblocks - HTML for the side-pre block region.

    Example context (json):
    {
        "blocksdraweropen": true,
        "sidepreblocks": "<h2>Blocks HTML goes here</h2>"
    }
}}
<div id="blocks-drawer" data-region="drawer" class="moodle-has-zindex {{^blocksdraweropen}}closed{{/blocksdraweropen}}" aria-hidden="{{#blocksdraweropen}}false{{/blocksdraweropen}}{{^blocksdraweropen}}true{{/blocksdraweropen}}">
    {{{ sidepreblocks }}}
</div>
