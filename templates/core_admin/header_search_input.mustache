{{!
    @template core_admin/header_search_input

    Admin search input for the page header, as in mockup/general.png: one field with the search icon
    inside it. Pressing Enter submits the search.

    Example context (json):
    {
        "action": "http://moodle.local/admin/search.php",
        "query": "themedesigner"
    }
}}
<div class="simplesearchform retani-adminsearch d-flex justify-content-end">
    <form autocomplete="off" action="{{action}}" method="get" accept-charset="utf-8" class="mform simplesearchform" role="search">
        <label for="searchinput-{{uniqid}}" class="visually-hidden">{{#str}}adminsearch:placeholder, theme_retani_studio{{/str}}</label>
        <span class="retani-adminsearch-icon" aria-hidden="true">{{#pix}}a/search, core{{/pix}}</span>
        <input type="search"
               id="searchinput-{{uniqid}}"
               class="form-control retani-adminsearch-input"
               placeholder="{{#str}}adminsearch:placeholder, theme_retani_studio{{/str}}"
               name="query"
               data-region="input"
               autocomplete="off"
               {{#query}}value="{{.}}"{{/query}}
        >
        <button type="submit" class="visually-hidden">{{#str}}search, core{{/str}}</button>
    </form>
</div>
