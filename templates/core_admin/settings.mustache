{{!
    @template core_admin/settings

    Admin settings form, as in mockup/admin-settings.png.

    Each heading of the settings page becomes a collapsible card with a settings count; the last card
    carries the footer with the save status, Cancel and Save changes. The sections are built by
    theme_retani_studio\output\core_renderer::render_from_template(). Without them (pages that lay
    out their own settings, such as the tabbed theme settings) the raw settings HTML goes in one card.

    Context variables required for this template:
    * actionurl - url to submit to
    * params - list of parameters containing name and value
    * return - page to return to
    * title - form title
    * settings - raw html for settings
    * showsave - true if we need save buttons
    * sections - optional list of {id, title, description, html, count, countlabel, hascount}
    * hassections - true when sections is not empty

    Example context (json):
    {
        "actionurl": "/",
        "return": "/",
        "title": null,
        "settings": "RAW HTML",
        "showsave": true,
        "hassections": true,
        "sections": [
            {
                "id": "retani-settings-section-0",
                "title": "Experimental",
                "description": null,
                "html": "RAW HTML",
                "count": 2,
                "hascount": true,
                "countlabel": "2 settings"
            }
        ]
    }
}}
<form action="{{actionurl}}" method="post" id="adminsettings" class="retani-settings" data-region="retani-settings">
    <div class="settingsform">
        {{#params}}
            <input type="hidden" name="{{name}}" value="{{value}}">
            <input type="hidden" name="action" value="save-settings">
        {{/params}}
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <input type="hidden" name="return" value="{{return}}">
        {{#title}}
            <h2>{{title}}</h2>
        {{/title}}

        {{#hassections}}
            {{#sections}}
                <section class="retani-settings-card" aria-labelledby="{{id}}-title">
                    <div class="retani-settings-card-header">
                        <button type="button" class="retani-settings-toggle" id="{{id}}-title"
                                data-bs-toggle="collapse" data-bs-target="#{{id}}"
                                aria-expanded="true" aria-controls="{{id}}">
                            <span class="retani-settings-chevron" aria-hidden="true">{{#pix}}t/collapsedchevron, core{{/pix}}</span>
                            <span class="retani-settings-title">{{title}}</span>
                        </button>
                        {{#hascount}}
                            <span class="retani-settings-count">{{countlabel}}</span>
                        {{/hascount}}
                    </div>
                    <div class="collapse show" id="{{id}}">
                        <div class="retani-settings-card-body">
                            {{#description}}
                                <div class="retani-settings-description">{{{description}}}</div>
                            {{/description}}
                            <fieldset>
                                {{{html}}}
                            </fieldset>
                        </div>
                    </div>
                </section>
            {{/sections}}
        {{/hassections}}
        {{^hassections}}
            <section class="retani-settings-card">
                <div class="retani-settings-card-body">
                    {{{settings}}}
                </div>
            </section>
        {{/hassections}}

        {{#showsave}}
            <div class="retani-settings-footer">
                <span class="retani-settings-status" data-region="retani-settings-status" data-state="saved" aria-live="polite">
                    <span class="retani-settings-status-dot" aria-hidden="true"></span>
                    <span data-region="retani-settings-status-text">{{#str}}adminsettings:saved, theme_retani_studio{{/str}}</span>
                </span>
                <div class="retani-settings-actions">
                    <button type="reset" class="btn btn-outline-secondary" data-action="retani-settings-cancel">{{#str}}cancel{{/str}}</button>
                    <button type="submit" class="btn btn-primary">{{#str}}savechanges, admin{{/str}}</button>
                </div>
            </div>
        {{/showsave}}
    </div>
</form>
{{#js}}
    require(['theme_retani_studio/adminsettings'], function(AdminSettings) {
        AdminSettings.init('adminsettings');
    });
{{/js}}
