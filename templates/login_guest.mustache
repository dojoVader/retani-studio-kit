{{!
    @template theme_retani_studio/login_guest

    Guest login button, shown alongside the identity providers at the top of the login form.

    Context variables required for this template:
    * loginurl - Login url.
    * logintoken - Random token to protect login request.

    Example context (json):
    {
        "loginurl": "http://localhost/login/index.php",
        "logintoken": "randomstring"
    }
}}
<form action="{{loginurl}}" method="post" id="guestlogin">
    <input type="hidden" name="logintoken" value="{{logintoken}}">
    <input type="hidden" name="username" value="guest" />
    <input type="hidden" name="password" value="guest" />
    <button class="btn login-identityprovider-btn" type="submit" id="loginguestbtn"><i class="fa fa-user" aria-hidden="true"></i>{{#str}}loginasguest{{/str}}</button>
</form>
